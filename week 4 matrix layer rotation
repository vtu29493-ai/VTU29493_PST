import java.io.*;
import java.util.*;

class Result {

    public static void matrixRotation(List<List<Integer>> matrix, int r) {
        int m = matrix.size();
        int n = matrix.get(0).size();
        int numLayers = Math.min(m, n) / 2;
        
        int[][] result = new int[m][n];

        for (int layer = 0; layer < numLayers; layer++) {
            List<Integer> list = new ArrayList<Integer>();

            // 1. Top row (left to right)
            for (int col = layer; col < n - layer; col++) {
                list.add(matrix.get(layer).get(col));
            }
            // 2. Right column (top to bottom)
            for (int row = layer + 1; row < m - layer - 1; row++) {
                list.add(matrix.get(row).get(n - layer - 1));
            }
            // 3. Bottom row (right to left)
            for (int col = n - layer - 1; col >= layer; col--) {
                list.add(matrix.get(m - layer - 1).get(col));
            }
            // 4. Left column (bottom to top)
            for (int row = m - layer - 2; row > layer; row--) {
                list.add(matrix.get(row).get(layer));
            }

            // Calculate effective rotation shift
            int size = list.size();
            int shift = r % size;

            // Reassign rotated values back into result matrix
            int idx = shift;

            // 1. Top row
            for (int col = layer; col < n - layer; col++) {
                result[layer][col] = list.get(idx);
                idx = (idx + 1) % size;
            }
            // 2. Right column
            for (int row = layer + 1; row < m - layer - 1; row++) {
                result[row][n - layer - 1] = list.get(idx);
                idx = (idx + 1) % size;
            }
            // 3. Bottom row
            for (int col = n - layer - 1; col >= layer; col--) {
                result[m - layer - 1][col] = list.get(idx);
                idx = (idx + 1) % size;
            }
            // 4. Left column
            for (int row = m - layer - 2; row > layer; row--) {
                result[row][layer] = list.get(idx);
                idx = (idx + 1) % size;
            }
        }

        // Print final matrix output
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                sb.append(result[i][j]).append(j == n - 1 ? "" : " ");
            }
            sb.append("\n");
        }
        System.out.print(sb.toString());
    }
}

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader bufferedReader = new BufferedReader(new InputStreamReader(System.in));

        String[] firstMultipleInput = bufferedReader.readLine().replaceAll("\\s+$", "").split(" ");

        int m = Integer.parseInt(firstMultipleInput[0]);
        int n = Integer.parseInt(firstMultipleInput[1]);
        int r = Integer.parseInt(firstMultipleInput[2]);

        List<List<Integer>> matrix = new ArrayList<List<Integer>>();

        for (int i = 0; i < m; i++) {
            String[] matrixRowTempItems = bufferedReader.readLine().replaceAll("\\s+$", "").split(" ");

            List<Integer> matrixRowItems = new ArrayList<Integer>();

            for (int j = 0; j < n; j++) {
                int matrixItem = Integer.parseInt(matrixRowTempItems[j]);
                matrixRowItems.add(matrixItem);
            }

            matrix.add(matrixRowItems);
        }

        Result.matrixRotation(matrix, r);

        bufferedReader.close();
    }
}
