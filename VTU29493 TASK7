public class Main {
    public static long getNthFibonacci(int n) {
        if (n <= 0) return 0;
        if (n == 1) return 1;

        long prev = 0;
        long current = 1;

        for (int i = 2; i <= n; i++) {
            long next = prev + current;
            prev = current;
            current = next;
        }

        return current;
    }

    public static void main(String[] args) {
        int n = 12;
        System.out.println("Fibonacci at position " + n + " is: " + getNthFibonacci(n));
    }
}
